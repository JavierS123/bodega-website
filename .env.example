# ─────────────────────────────────────────────────────────────────────────────
# BodegaOS — environment variables
# Copy to `.env.local` (Next.js + drizzle-kit both read it) and fill in values.
# Never commit real secrets. On Vercel, set these in Project → Settings → Env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase Postgres) ────────────────────────────────────────────
# Runtime connection used by the app (Drizzle + `postgres` driver).
# Use the *Transaction pooler* string (port 6543) from:
#   Supabase Dashboard → Connect → ORMs / Connection string → Transaction pooler
# Prepared statements are disabled in src/db/index.ts, as the pooler requires.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Optional: connection used by drizzle-kit (push / migrate / studio).
# Use the *Session pooler* string (port 5432) — DDL is more reliable there.
# Falls back to DATABASE_URL when unset.
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Supabase Auth ───────────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API (or Connect → App Frameworks).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-or-publishable-key>"

# ── Admin allowlist ─────────────────────────────────────────────────────────
# Comma-separated emails treated as admins (case-insensitive), in addition to
# any user whose app_metadata.role === "admin". There is no public sign-up:
# create these users manually in Supabase Auth (or via scripts/seed-admin.ts).
ADMIN_EMAILS="owner1@example.com,owner2@example.com"

# ── Public site URL ─────────────────────────────────────────────────────────
# Absolute base for OpenGraph/Twitter preview images. Optional on Vercel (falls
# back to VERCEL_PROJECT_PRODUCTION_URL); set it for a custom domain.
# NEXT_PUBLIC_SITE_URL="https://bodega.example.com"

# ── AI Cashier (Google Gemini) ──────────────────────────────────────────────
# https://aistudio.google.com/apikey — server-side only, never NEXT_PUBLIC_.
GEMINI_API_KEY="<gemini-api-key>"
# Optional model override (default: gemini-3.5-flash-lite).
# GEMINI_MODEL="gemini-3.5-flash-lite"

# ── Telegram bot (legacy workflow bridge) ───────────────────────────────────
# Token from @BotFather.
TELEGRAM_BOT_TOKEN="<bot-token>"
# Random string sent by Telegram in the X-Telegram-Bot-Api-Secret-Token header
# (set via setWebhook's `secret_token`). Generate e.g. `openssl rand -hex 32`.
TELEGRAM_WEBHOOK_SECRET="<random-secret>"
# Comma-separated numeric Telegram user IDs allowed to log transactions.
TELEGRAM_ALLOWED_USER_IDS="123456789,987654321"
